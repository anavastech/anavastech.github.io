---
import { t, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';
import { cvPath, profilePhoto } from '../data/assets';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const photo = profilePhoto();
const cv = cvPath(lang);
---

<section class="hero" aria-labelledby="hero-name">
  <div class="container grid">
    <div class="text">
      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        {t(lang, 'hero.role')} · {profile.location[lang]}
      </p>
      <h1 id="hero-name">{profile.name}</h1>
      <p class="tagline">{profile.tagline[lang]}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#proyectos">{t(lang, 'hero.cta.projects')}</a>
        {
          cv && (
            <a class="btn btn-ghost" href={cv} download data-testid="cv-download">
              {t(lang, 'hero.cta.cv')}
            </a>
          )
        }
        <a class="btn btn-ghost" href={profile.github} rel="noopener">GitHub ↗</a>
        <a class="btn btn-ghost" href={profile.linkedin} rel="noopener">LinkedIn ↗</a>
      </div>
    </div>
    <div class="avatar" data-testid="profile-photo">
      {
        photo ? (
          <img src={photo} alt={t(lang, 'about.photoAlt')} width="320" height="320" />
        ) : (
          <span class="initials" aria-hidden="true">
            {profile.initials}
          </span>
        )
      }
    </div>
  </div>

  <div class="container">
    <dl class="facts">
      {
        profile.facts.map((fact) => (
          <div>
            <dt>{fact.value[lang]}</dt>
            <dd>{fact.label[lang]}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 2.5rem 0 3rem;
    overflow: hidden;
    isolation: isolate;
  }

  /* Cuadrícula tenue que se desvanece hacia abajo, con un brillo del color de acento detrás del texto. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 55% at 15% 20%, var(--accent-soft), transparent 70%),
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 40px 40px;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .grid {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.1rem;
    padding: 0.3rem 0.85rem 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 500;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  h1 {
    font-size: clamp(2.3rem, 6.5vw, 4rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .tagline {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--muted);
    max-width: 46ch;
    margin: 1.25rem 0 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .avatar {
    order: -1;
    justify-self: start;
    width: 128px;
    aspect-ratio: 1;
    border-radius: 28px;
    overflow: hidden;
    border: 4px solid var(--surface);
    box-shadow: 0 0 0 1px var(--border), var(--shadow);
    background: var(--accent-soft);
    rotate: 2deg;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: 2.75rem;
    font-weight: 700;
    color: var(--accent);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin: 3rem 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--border);
    overflow: hidden;
  }

  .facts div {
    padding: 1.1rem 1.25rem;
    background: var(--surface);
  }

  /* En dos columnas, la tercera cifra ocupa todo el ancho para no dejar un hueco. */
  .facts div:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .facts dt {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .facts dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  @media (min-width: 800px) {
    .hero {
      padding: 6rem 0 4.5rem;
    }

    .grid {
      grid-template-columns: 1.7fr 1fr;
    }

    .avatar {
      order: 0;
      width: 300px;
      justify-self: end;
    }

    .initials {
      font-size: 5rem;
    }

    .facts {
      grid-template-columns: repeat(3, 1fr);
      margin-top: 4rem;
    }

    .facts div:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>
