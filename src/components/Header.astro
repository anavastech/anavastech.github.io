---
import { homePath, t, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  alternate: string;
}

const { lang, alternate } = Astro.props;
const home = homePath(lang);
const links = [
  { href: `${home}#sobre-mi`, label: t(lang, 'nav.about') },
  { href: `${home}#experiencia`, label: t(lang, 'nav.experience') },
  { href: `${home}#proyectos`, label: t(lang, 'nav.projects') },
  { href: `${home}#contacto`, label: t(lang, 'nav.contact') },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home}>
      <span class="logo" aria-hidden="true">{profile.initials}</span>
      <span>{profile.shortName}</span>
    </a>
    <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul class="links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <a class="lang" href={alternate} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'} data-testid="lang-switch">
      {lang === 'es' ? 'EN' : 'ES'}<span class="visually-hidden"> — {t(lang, 'nav.switch')}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
  }

  .logo {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.85rem;
  }

  .links {
    display: none;
    list-style: none;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .links a:hover {
    color: var(--text);
  }

  .lang {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .lang:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (min-width: 760px) {
    .links {
      display: flex;
    }
  }
</style>
