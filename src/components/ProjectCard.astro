---
import { projectPath, t, type Lang } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const badge = `${project.repo}/actions/workflows/${project.workflow}/badge.svg`;
const kindLabel = t(lang, project.kind === 'mobile' ? 'projects.kind.mobile' : 'projects.kind.web');
---

<article class={`card project kind-${project.kind}`} data-testid={`project-${project.slug}`}>
  <div class="top">
    <span class="kind" data-testid="project-kind">
      {
        project.kind === 'mobile' ? (
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M10.5 18.5h3" /></svg>
        ) : (
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M2.5 12h19M12 2.5c2.6 2.8 3.9 6 3.9 9.5S14.6 18.7 12 21.5M12 2.5C9.4 5.3 8.1 8.5 8.1 12s1.3 6.7 3.9 9.5" /></svg>
        )
      }
      {kindLabel}
    </span>
    <img class="badge" src={badge} alt={`CI: ${project.name}`} height="20" loading="lazy" />
  </div>

  <h3>{project.name}</h3>
  <p class="target"><span>{t(lang, 'projects.target')}:</span> {project.target[lang]}</p>
  <p class="summary">{project.summary[lang]}</p>

  <ul class="stats">
    {
      project.stats.map((stat) => (
        <li>
          <strong>{stat.value}</strong>
          <span>{stat.label[lang]}</span>
        </li>
      ))
    }
  </ul>

  <ul class="stack" aria-label={t(lang, 'projects.keyStack')}>
    {project.keyStack.map((tech) => <li class="tag">{tech}</li>)}
  </ul>

  <div class="actions">
    <a class="btn btn-primary" href={projectPath(lang, project.slug)}>{t(lang, 'projects.details')}</a>
    <a class="btn btn-ghost" href={project.repo} rel="noopener" data-testid="repo-link">
      {t(lang, 'projects.repo')} ↗
    </a>
  </div>
</article>

<style>
  .project {
    --kind: var(--accent);
    --kind-soft: var(--accent-soft);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  /* Franja superior de color según el tipo: móvil y web se distinguen de un vistazo. */
  .project::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--kind);
  }

  .kind-mobile {
    --kind: var(--mobile);
    --kind-soft: var(--mobile-soft);
  }

  .project:hover {
    transform: translateY(-3px);
    border-color: var(--kind);
  }

  @media (prefers-reduced-motion: reduce) {
    .project,
    .project:hover {
      transition: none;
      transform: none;
    }
  }

  .top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .kind {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.7rem 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--kind-soft);
    color: var(--kind-text, var(--text));
    font-size: 0.82rem;
    font-weight: 600;
  }

  .kind svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--kind);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  h3 {
    font-size: 1.25rem;
  }

  .target {
    margin: -0.4rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .target span {
    font-weight: 600;
    color: var(--text);
  }

  .summary {
    margin: 0;
    color: var(--muted);
  }

  .stats {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .stats li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.85rem;
    border-radius: 10px;
    background: var(--surface-2);
    border-left: 3px solid var(--kind);
  }

  .stats strong {
    color: var(--kind);
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .stats span {
    font-size: 0.87rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .actions .btn {
    justify-content: center;
    padding: 0.65rem 0.75rem;
    white-space: nowrap;
  }
</style>
