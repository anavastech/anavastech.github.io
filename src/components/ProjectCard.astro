---
import { projectPath, t, type Lang } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const badge = `${project.repo}/actions/workflows/${project.workflow}/badge.svg`;
const kindLabel = t(lang, `projects.kind.${project.kind}`);
---

<article class={`card project kind-${project.kind}`} data-testid={`project-${project.slug}`}>
  <div class="top">
    <span class="kind" data-testid="project-kind">
      {
        project.kind === 'mobile' ? (
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M10.5 18.5h3" /></svg>
        ) : project.kind === 'api' ? (
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5 3 12l5 7M16 5l5 7-5 7M13.5 4l-3 16" /></svg>
        ) : (
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M2.5 12h19M12 2.5c2.6 2.8 3.9 6 3.9 9.5S14.6 18.7 12 21.5M12 2.5C9.4 5.3 8.1 8.5 8.1 12s1.3 6.7 3.9 9.5" /></svg>
        )
      }
      {kindLabel}
    </span>
    <img class="badge" src={badge} alt={`CI: ${project.name}`} height="20" loading="lazy" />
  </div>

  <div>
    <h3>{project.name}</h3>
    <p class="target">{project.target[lang]}</p>
  </div>

  <p class="summary">{project.summary[lang]}</p>

  <dl class="stats">
    {
      project.stats.map((stat) => (
        <div>
          <dt>{stat.value}</dt>
          <dd>{stat.label[lang]}</dd>
        </div>
      ))
    }
  </dl>

  <p class="ci">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v4h-4" /></svg>
    {project.ci[lang]}
  </p>

  <ul class="stack" aria-label={t(lang, 'projects.keyStack')}>
    {project.keyStack.map((tech) => <li>{tech}</li>)}
  </ul>

  <div class="actions">
    <a class="btn btn-primary" href={projectPath(lang, project.slug)}>{t(lang, 'projects.details')}</a>
    <a class="btn btn-ghost" href={project.repo} rel="noopener" data-testid="repo-link">
      {t(lang, 'projects.repo')} ↗
    </a>
  </div>
</article>

<style>
  .project {
    --kind: var(--accent);
    --kind-soft: var(--accent-soft);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--bg);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .kind-mobile {
    --kind: var(--mobile);
    --kind-soft: var(--mobile-soft);
  }

  .kind-api {
    --kind: var(--api);
    --kind-soft: var(--api-soft);
  }

  .project:hover {
    transform: translateY(-3px);
    border-color: var(--kind);
  }

  @media (prefers-reduced-motion: reduce) {
    .project,
    .project:hover {
      transition: none;
      transform: none;
    }
  }

  @media (min-width: 640px) {
    .project {
      padding: 1.75rem;
    }
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
  }

  .kind {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.7rem 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--kind-soft);
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .kind svg,
  .ci svg {
    width: 1rem;
    height: 1rem;
    flex: none;
    fill: none;
    stroke: var(--kind);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h3 {
    font-size: 1.35rem;
  }

  .target {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .summary {
    margin: 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stats div {
    padding: 0.9rem 0.75rem 0.9rem 0;
  }

  .stats div + div {
    padding-left: 0.75rem;
    border-left: 1px solid var(--border);
  }

  .stats dt {
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--kind);
  }

  .stats dd {
    margin: 0.25rem 0 0;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .ci {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .stack li::before {
    content: '#';
    color: var(--kind);
    margin-right: 0.15rem;
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .actions .btn {
    justify-content: center;
    padding: 0.65rem 0.75rem;
    white-space: nowrap;
  }
</style>
