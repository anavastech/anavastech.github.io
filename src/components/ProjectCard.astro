---
import { projectPath, t, type Lang } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const badge = `${project.repo}/actions/workflows/${project.workflow}/badge.svg`;
---

<article class="card project" data-testid={`project-${project.slug}`}>
  <div class="head">
    <h3>{project.name}</h3>
    <img src={badge} alt={`CI: ${project.name}`} height="20" loading="lazy" />
  </div>
  <p class="summary">{project.summary[lang]}</p>
  <dl class="stats">
    {
      project.stats.map((stat) => (
        <div>
          <dt>{stat.value}</dt>
          <dd>{stat.label[lang]}</dd>
        </div>
      ))
    }
  </dl>
  <ul class="stack" aria-label={t(lang, 'projects.stack')}>
    {project.stack.map((tech) => <li class="tag">{tech}</li>)}
  </ul>
  <div class="actions">
    <a class="btn btn-primary" href={projectPath(lang, project.slug)}>{t(lang, 'projects.details')}</a>
    <a class="btn btn-ghost" href={project.repo} rel="noopener" data-testid="repo-link">
      {t(lang, 'projects.repo')} ↗
    </a>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  h3 {
    font-size: 1.2rem;
  }

  .summary {
    margin: 0;
    color: var(--muted);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin: 0;
  }

  .stats div {
    background: var(--surface-2);
    border-radius: 10px;
    padding: 0.6rem 0.75rem;
  }

  dt {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--accent);
  }

  dd {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.3;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: auto;
  }
</style>
